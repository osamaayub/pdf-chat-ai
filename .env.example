# Pick ONE key. With none, the app runs in free demo mode (keyword search, quoted answers, no AI calls).

# OpenAI: embeddings for search + GPT answers
OPENAI_API_KEY=

# Anthropic: BM25 keyword search + Claude answers
ANTHROPIC_API_KEY=

# Optional: force a provider when both keys are set (openai | anthropic | demo)
# AI_PROVIDER=anthropic
# Optional model overrides
# OPENAI_MODEL=gpt-4.1-mini
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# CLAUDE_MODEL=claude-haiku-5-5
